{
  "name": "algorithm-visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @algoviz/playground",
    "build": "vue-tsc --build && npm run build --workspaces --if-present",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e -w @algoviz/playground && npm run test:e2e -w @algoviz/site",
    "test:typst": "npm run test:typst -w @algoviz/typst",
    "test:standalone": "npm run test:standalone -w @algoviz/mcp",
    "test:latex": "npm run test:latex -w @algoviz/latex",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepare": "husky",
    "gallery": "node --conditions=@algoviz/source scripts/gallery.ts",
    "sizes": "node --conditions=@algoviz/source scripts/sizes.ts",
    "generate:fonts": "node --conditions=@algoviz/source scripts/fonts.ts",
    "test:worker": "npm run test:worker -w @algoviz/worker"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.9",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "workspaces": [
    "packages/spec",
    "packages/fonts",
    "packages/core",
    "packages/svg",
    "packages/tikz",
    "packages/recipes",
    "packages/typst",
    "packages/mcp",
    "packages/latex",
    "packages/elements",
    "apps/playground",
    "apps/site",
    "apps/worker"
  ]
}
