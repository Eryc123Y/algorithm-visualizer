      "T": {
        "kind": "array",
        "initial": ["a", "c", "a", "a", "b", "c"],
        "pattern": ["a", "a", "b"]
      }
    },
    "steps": [
      {
        "actions": [
          { "target": "T", "type": "align", "shift": 0, "matched": 2 }
