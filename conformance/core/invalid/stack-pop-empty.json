{
  "description": "Popping an empty stack is an error.",
  "input": {
    "version": "1.0",
    "structures": {
      "st": {
        "kind": "stack",
        "initial": []
      }
    },
    "steps": [
      {
        "actions": [
          {
            "target": "st",
            "type": "pop"
          }
        ]
      }
    ]
  },
  "expectedErrors": [
    {
      "code": "EMPTY",
      "path": "$.steps[0].actions[0]"
    }
  ]
}
