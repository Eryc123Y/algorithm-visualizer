{
  "description": "Link targets must exist.",
  "input": {
    "version": "0.1",
    "structures": {
      "ll": {
        "kind": "linkedList",
        "initial": [1, 2]
      }
    },
    "steps": [
      {
        "actions": [
          {
            "target": "ll",
