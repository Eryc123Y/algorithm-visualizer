                ]
              },
              "settled": []
            }
          }
        }
      }
    },
    {
      "index": 4,
      "state": {
        "dp": {
          "kind": "table",
          "state": {
            "data": [
              [0, 0, 0],
              [0, 1, 1]
            ],
            "marks": {
              "highlight": [],
              "depend": null,
              "settled": [
                [1, 1],
