{
  "description": "place is \"main\" or \"side\".",
  "input": {
    "version": "0.4",
    "structures": {
      "a": {
        "kind": "array",
        "initial": [3, 1, 2]
      },
      "calls": {
        "kind": "stack",
        "label": "call stack",
        "initial": [],
        "place": "right"
      },
      "out": {
        "kind": "array",
        "initial": [],
        "place": "main"
      }
    },
    "steps": [
      {
        "actions": [
          {
            "target": "calls",
            "type": "push",
            "element": "sort a[0..2]"
          },
          {
            "target": "a",
            "type": "compare",
            "i": 0,
            "j": 1
          }
        ]
      },
      {
        "actions": [
          {
            "target": "a",
            "type": "swap",
            "i": 0,
            "j": 1
          },
          {
            "target": "out",
            "type": "insert",
            "index": 0,
            "element": 1
          }
        ]
      },
      {
        "actions": [
          {
            "target": "calls",
            "type": "pop"
          }
        ]
      }
    ]
  },
  "expectedErrors": [
    {
      "code": "INVALID_SHAPE",
      "path": "$.structures.calls.place"
    }
  ]
}
