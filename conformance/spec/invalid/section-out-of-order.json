{
  "description": "Sections are listed in order and do not overlap, so each starts at a later step than the one before; an empty section is out of order too.",
  "input": {
    "version": "0.2",
    "structures": { "a": { "kind": "array", "initial": [1, 2] } },
    "steps": [
      {
        "actions": [{ "target": "a", "type": "compare", "i": 0, "j": 1 }],
        "meta": { "id": "compare" }
      },
      {
        "actions": [{ "target": "a", "type": "swap", "i": 0, "j": 1 }],
        "meta": { "id": "swap" }
      }
    ],
    "sections": [
      { "id": "swap", "title": "Swap", "start": 1 },
      { "id": "compare", "title": "Compare", "start": 0 },
      { "id": "again", "title": "Again", "start": 0 }
    ]
  },
  "expectedErrors": [
    { "code": "SECTION_OUT_OF_ORDER", "path": "$.sections[1].start" },
    { "code": "SECTION_OUT_OF_ORDER", "path": "$.sections[2].start" }
  ]
}
