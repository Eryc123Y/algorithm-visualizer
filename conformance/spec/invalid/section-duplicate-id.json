{
  "description": "Section ids are unique within a document, unlike step names.",
  "input": {
    "version": "0.2",
    "structures": { "a": { "kind": "array", "initial": [1, 2] } },
    "steps": [
      {
        "actions": [{ "target": "a", "type": "compare", "i": 0, "j": 1 }],
        "meta": { "id": "compare" }
      },
      {
        "actions": [{ "target": "a", "type": "swap", "i": 0, "j": 1 }],
        "meta": { "id": "swap" }
      }
    ],
    "sections": [
      { "id": "step", "title": "First", "start": 0 },
      { "id": "step", "title": "Second", "start": 1 }
    ]
  },
  "expectedErrors": [
    { "code": "DUPLICATE_SECTION", "path": "$.sections[1].id" }
  ]
}
