{
  "version": "0.1",
  "title": "Sliding window maximum with deque",
  "structures": {
    "arr": {
      "kind": "array",
      "initial": [
        1,
        3,
        -1,
        -3,
        5,
        3,
        6,
        7
      ]
    },
    "dq": {
      "kind": "queue",
      "initial": [],
      "label": "deque of indices"
    },
    "output": {
      "kind": "array",
      "initial": [],
      "label": "result"
    }
  },
  "steps": [
    {
      "actions": [
        {
          "target": "arr",
          "type": "highlight",
          "indices": [
            0
          ]
        }
      ],
      "meta": {
        "narration": "Start with the first element at index 0 (value 1). Add its index to the deque."
      }
    },
    {
      "actions": [
        {
          "target": "dq",
          "type": "enqueue",
          "element": 0
        },
        {
          "target": "arr",
          "type": "highlight",
          "indices": [
            1
          ]
        }
      ],
      "meta": {
        "narration": "At index 1 (value 3): since 3 > 1, remove index 0 from the deque and add 1."
      }
    },
    {
      "actions": [
        {
          "target": "dq",
          "type": "dequeue"
        },
        {
          "target": "dq",
          "type": "enqueue",
          "element": 1
        },
        {
          "target": "arr",
          "type": "highlight",
          "indices": [
            2
          ]
        }
      ],
      "meta": {
        "narration": "At index 2 (value -1): add it to the deque. Window [1, 3, -1] is complete, max is 3."
      }
    },
    {
      "actions": [
        {
          "target": "dq",
          "type": "enqueue",
          "element": 2
        },
        {
          "target": "output",
          "type": "insert",
          "index": 0,
          "element": 3
        },
        {
          "target": "arr",
          "type": "highlight",
          "indices": [
            3
          ]
        }
      ],
      "meta": {
        "narration": "At index 3 (value -3): index 0 is out of window. Add 3 to deque. Max is -1."
      }
    },
    {
      "actions": [
        {
          "target": "dq",
          "type": "enqueue",
          "element": 3
        },
        {
          "target": "output",
          "type": "insert",
          "index": 1,
          "element": -1
        },
        {
          "target": "arr",
          "type": "highlight",
          "indices": [
            4
          ]
        }
      ],
      "meta": {
        "narration": "At index 4 (value 5): remove indices 2 and 3 (both smaller than 5), add 4. Max is 5."
      }
    },
    {
      "actions": [
        {
          "target": "dq",
          "type": "dequeue"
        },
        {
          "target": "dq",
          "type": "dequeue"
        },
        {
          "target": "dq",
          "type": "enqueue",
          "element": 4
        },
        {
          "target": "output",
          "type": "insert",
          "index": 2,
          "element": 5
        },
        {
          "target": "arr",
          "type": "highlight",
          "indices": [
            5
          ]
        }
      ],
      "meta": {
        "narration": "At index 5 (value 3): add to deque. Window [5, 3, 6] is [value -3, 5, 3], max is 5."
      }
    },
    {
      "actions": [
        {
          "target": "dq",
          "type": "enqueue",
          "element": 5
        },
        {
          "target": "output",
          "type": "insert",
          "index": 3,
          "element": 5
        },
        {
          "target": "arr",
          "type": "highlight",
          "indices": [
            6
          ]
        }
      ],
      "meta": {
        "narration": "At index 6 (value 6): remove indices 4 and 5, add 6. Max is 6."
      }
    },
    {
      "actions": [
        {
          "target": "dq",
          "type": "dequeue"
        },
        {
          "target": "dq",
          "type": "dequeue"
        },
        {
          "target": "dq",
          "type": "enqueue",
          "element": 6
        },
        {
          "target": "output",
          "type": "insert",
          "index": 4,
          "element": 6
        },
        {
          "target": "arr",
          "type": "highlight",
          "indices": [
            7
          ]
        }
      ],
      "meta": {
        "narration": "At index 7 (value 7): remove index 6, add 7. Max is 7."
      }
    },
    {
      "actions": [
        {
          "target": "dq",
          "type": "dequeue"
        },
        {
          "target": "dq",
          "type": "enqueue",
          "element": 7
        },
        {
          "target": "output",
          "type": "insert",
          "index": 5,
          "element": 7
        }
      ],
      "meta": {
        "narration": "Done. The result array contains all maxima: [3, -1, 5, 5, 6, 7]."
      }
    }
  ]
}
