// The Worker's configuration. The name is part of the Worker's workers.dev
// address; a copy deployed to another account may pick its own (README).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "algomotion-mcp",
  "main": "dist/worker.js",
  "compatibility_date": "2026-10-01",
  "no_bundle": true,
  "build": {
    "command": "npm run build",
  },
  // One client IP may make 60 requests a minute; the namespace id is any
  // integer unique within your account.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // Share links (ADR 0040): the address of the share page, the site's
  // play/ page. algomotion_show and algomotion_run_recipe return a link to
  // it. A copy on another account sets its own page, or removes "vars" to
  // make no links.
  "vars": {
    "ALGOMOTION_SHARE_URL": "https://algomotion.ericyxy123.workers.dev/play/",
  },
  "observability": { "enabled": false },
}
