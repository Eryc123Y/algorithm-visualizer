// The Worker's configuration. "algoviz-mcp-example" is a placeholder:
// choose your own Worker name before deploying (README).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "algoviz-mcp-example",
  "main": "dist/worker.js",
  "compatibility_date": "2026-10-01",
  "no_bundle": true,
  "build": {
    "command": "npm run build",
  },
  // One client IP may make 60 requests a minute; the namespace id is any
  // integer unique within your account.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
