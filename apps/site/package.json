{
  "name": "@algomotion/site",
  "version": "0.0.0",
  "private": true,
  "description": "The static site: the documentation, generated from the registry, and the share page (ADR 0040).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node --conditions=@algomotion/source scripts/build-pages.ts",
    "preview": "vite preview",
    "test:e2e": "NODE_OPTIONS=--conditions=@algomotion/source playwright test",
    "scenes": "node --conditions=@algomotion/source scripts/scenes.ts"
  },
  "dependencies": {
    "@algomotion/elements": "1.0.0",
    "@algomotion/recipes": "1.0.0",
    "@algomotion/spec": "1.0.0",
    "@algomotion/svg": "1.0.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0"
  }
}
