{
  "name": "@algomotion/tikz",
  "version": "0.0.0",
  "private": true,
  "description": "Renders algomotion scenes as TikZ for LaTeX, with the document's fonts (ADR 0027).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@algomotion/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.lib.json"
  },
  "dependencies": {
    "@algomotion/core": "*",
    "@algomotion/spec": "*",
    "@algomotion/svg": "*"
  },
  "devDependencies": {
    "@algomotion/recipes": "*"
  }
}
