      "language": "python",
      "code": "def delete(node, key):\n    if node is None:\n        return None\n    if key < node.key:\n        node.left = delete(node.left, key)\n    elif key > node.key:\n        node.right = delete(node.right, key)\n    elif node.left is None:\n        return node.right\n    elif node.right is None:\n        return node.left\n    else:\n        succ = node.right\n        while succ.left is not None:\n            succ = succ.left\n        node.key = succ.key\n        node.right = delete(node.right, succ.key)\n    return node",
