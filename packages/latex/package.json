{
  "name": "@algomotion/latex",
  "version": "1.0.0",
  "private": true,
  "description": "The algomotion LaTeX package: figures drawn with TikZ in the document's fonts, made by the algomotion command (ADR 0027).",
  "type": "module",
  "scripts": {
    "build:doc": "node --conditions=@algomotion/source scripts/build-doc.ts",
    "test:latex": "vitest run --config vitest.latex.config.ts"
  },
  "devDependencies": {
    "@algomotion/core": "1.0.0",
    "@algomotion/mcp": "1.0.0",
    "@algomotion/recipes": "1.0.0",
    "@algomotion/svg": "1.0.0",
    "@algomotion/tikz": "1.0.0"
  }
}
