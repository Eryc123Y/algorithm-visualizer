{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    // Recipes only build documents, so they run anywhere.
    "lib": ["ES2022"],
    "types": [],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"],
  // Resolves @algoviz/spec and @algoviz/core to their built declarations,
  // so build them first.
  "references": [
    { "path": "../spec/tsconfig.lib.json" },
    { "path": "../core/tsconfig.lib.json" }
  ]
}
