{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    // Recipes only build documents, so they run anywhere.
    "lib": ["ES2022"],
    "types": [],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"],
  // Resolves @algoviz/spec to its built declarations, so build it first.
  "references": [{ "path": "../spec/tsconfig.lib.json" }]
}
