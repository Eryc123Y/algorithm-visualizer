{
  "name": "@algomotion/fonts",
  "version": "1.0.0-alpha.1",
  "description": "Metrics and glyph outlines of the fonts algomotion bundles, and text measurement. No DOM or Node.js APIs.",
  "keywords": [
    "algorithms",
    "visualization",
    "education",
    "fonts",
    "text-measurement"
  ],
  "license": "GPL-3.0-or-later AND OFL-1.1",
  "homepage": "https://algomotion.turing2234.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eryc123Y/algorithm-visualizer.git",
    "directory": "packages/fonts"
  },
  "bugs": {
    "url": "https://github.com/Eryc123Y/algorithm-visualizer/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@algomotion/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./encode": {
      "@algomotion/source": "./src/encode.ts",
      "types": "./dist/encode.d.ts",
      "default": "./dist/encode.js"
    }
  },
  "files": [
    "dist",
    "OFL.txt"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.lib.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
