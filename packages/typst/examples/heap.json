    {
      "language": "python",
      "code": "def push(h, x):\n    h.append(x)\n    i = len(h) - 1\n    while i > 0:\n        p = (i - 1) // 2\n        if h[p] <= h[i]:\n            break\n        h[i], h[p] = h[p], h[i]\n        i = p\n\ndef pop(h):\n    h[0], h[-1] = h[-1], h[0]\n    top = h.pop()\n    i = 0\n    while 2 * i + 1 < len(h):\n        c = 2 * i + 1\n        if c + 1 < len(h) and h[c + 1] < h[c]:\n            c += 1\n        if h[i] <= h[c]:\n            break\n        h[i], h[c] = h[c], h[i]\n        i = c\n    return top",
