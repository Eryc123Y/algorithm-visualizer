    {
      "language": "pseudocode",
      "code": "HEAP-PUSH(h, x)\n    h.size = h.size + 1\n    h[h.size - 1] = x\n    i = h.size - 1\n    while i > 0\n        p = ⌊(i - 1) / 2⌋  // the parent of i, counting from 0\n        if h[p] ≤ h[i]\n            return\n        exchange h[i] with h[p]\n        i = p\n\nHEAP-POP(h)\n    exchange h[0] with h[h.size - 1]\n    top = h[h.size - 1]\n    h.size = h.size - 1\n    i = 0\n    while 2i + 1 < h.size\n        c = 2i + 1  // the left child of i, counting from 0\n        if c + 1 < h.size and h[c + 1] < h[c]\n            c = c + 1\n        if h[i] ≤ h[c]\n            return top\n        exchange h[i] with h[c]\n        i = c\n    return top",
      "anchors": {
