{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    // No DOM and no Node.js types: the engine must stay portable (ADR 0005).
    "lib": ["ES2022"],
    "types": [],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"],
  // Resolves @algoviz/spec and @algoviz/fonts to their built declarations,
  // so build them first.
  "references": [
    { "path": "../spec/tsconfig.lib.json" },
    { "path": "../fonts/tsconfig.lib.json" }
  ]
}
