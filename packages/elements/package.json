{
  "name": "@algomotion/elements",
  "version": "1.0.0-alpha.1",
  "description": "Web Components for algomotion: the <algo-player> interactive player.",
  "keywords": [
    "algorithms",
    "visualization",
    "education",
    "web-components",
    "player",
    "animation"
  ],
  "license": "GPL-3.0-or-later",
  "homepage": "https://algomotion.turing2234.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eryc123Y/algorithm-visualizer.git",
    "directory": "packages/elements"
  },
  "bugs": {
    "url": "https://github.com/Eryc123Y/algorithm-visualizer/issues"
  },
  "type": "module",
  "sideEffects": [
    "./src/define.ts",
    "./dist/define.js",
    "./dist/cdn/*"
  ],
  "exports": {
    ".": {
      "@algomotion/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./define": {
      "@algomotion/source": "./src/define.ts",
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./fonts.css": {
      "@algomotion/source": "./src/fonts/fonts.css",
      "default": "./dist/fonts/fonts.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.lib.json && vite build --config vite.cdn.config.ts"
  },
  "dependencies": {
    "@algomotion/core": "1.0.0-alpha.1",
    "@algomotion/recipes": "1.0.0-alpha.1",
    "@algomotion/spec": "1.0.0-alpha.1",
    "@algomotion/svg": "1.0.0-alpha.1",
    "lit": "^3.3.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
