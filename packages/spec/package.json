{
  "name": "@algoviz/spec",
  "version": "0.0.0",
  "private": true,
  "description": "Protocol schemas, types and validation for algoviz traces.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
