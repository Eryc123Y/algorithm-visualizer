{
  "name": "@algomotion/spec",
  "version": "1.0.0-alpha.1",
  "description": "Protocol schemas, types and validation for algomotion traces.",
  "keywords": [
    "algorithms",
    "visualization",
    "education",
    "schema",
    "protocol"
  ],
  "license": "GPL-3.0-or-later",
  "homepage": "https://algomotion.turing2234.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eryc123Y/algorithm-visualizer.git",
    "directory": "packages/spec"
  },
  "bugs": {
    "url": "https://github.com/Eryc123Y/algorithm-visualizer/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@algomotion/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./visualization.schema.json": "./schema/visualization.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.lib.json",
    "generate:schema": "node scripts/generate-schema.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
